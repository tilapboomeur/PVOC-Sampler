#N canvas 40 40 1100 760 12;
#X text 20 10 MOTEUR VOCODEUR DE PHASE - Pd vanilla - pilote par messages (application Android via libpd);
#X text 20 35 Tableaux pv-L / pv-R: le fichier est ecrit avec 8192 zeros avant et apres. Messages: pv-load <longueur> / pv-play / pv-pause / pv-stop / pv-loop 0|1 / pv-speed <rapport> / pv-transpo <demi-tons> / pv-seek <0-1> / pv-vol <0-1> / pv-lock 0|1. Renvoie: pv-pos <0-1> / pv-end;
#X obj 20 90 array define pv-L;
#X obj 180 90 array define pv-R;
#X obj 340 90 array define pv-hann 2048;
#X obj 740 90 array define pv-pr 2048;
#X obj 900 90 array define pv-pi 2048;
#X obj 540 90 array define pv-ramp 2048;
#X obj 20 125 v pv_loc;
#X obj 130 125 v pv_play;
#X obj 240 125 v pv_speed;
#X obj 350 125 v pv_tr;
#X obj 460 125 v pv_loop;
#X obj 570 125 v pv_start;
#X obj 680 125 v pv_end;
#X obj 20 170 loadbang;
#X obj 20 195 t b b b;
#X obj 300 225 expr pv_speed = 1 \; pv_tr = 1 \; pv_loop = 0 \; pv_play = 0 \; pv_start = 8192 \; pv_end = 8192 \; pv_loc = 8192;
#X msg 120 225 0;
#X msg 20 225 2048;
#X obj 20 255 until;
#X obj 20 285 f;
#X obj 60 285 + 1;
#X obj 20 315 t f f f;
#X obj 20 345 expr 0.5 - 0.5*cos(6.283185307*$f1/2048);
#X obj 20 375 tabwrite pv-hann;
#X obj 180 375 tabwrite pv-ramp;
#X msg 200 195 0.8;
#X obj 20 420 r pv-load;
#X obj 20 445 expr pv_play = 0 \; pv_start = 8192 \; pv_end = 8192 + $f1 \; pv_loc = 8192;
#X obj 20 480 r pv-play;
#X obj 20 505 t b b;
#X obj 20 535 expr pv_loc = if(pv_speed >= 0 && pv_loc >= pv_end\, pv_start\, if(pv_speed < 0 && pv_loc <= pv_start\, pv_end\, pv_loc)) \; pv_play = 1;
#X msg 20 565 1 30;
#X obj 200 600 r pv-pause;
#X obj 200 625 expr pv_play = 0;
#X msg 200 655 0 30;
#X obj 340 600 r pv-stop;
#X obj 340 625 expr pv_play = 0;
#X obj 340 655 delay 40;
#X obj 340 680 expr pv_loc = pv_start;
#X obj 520 600 r pv-endreached;
#X obj 520 630 s pv-end;
#X obj 520 420 r pv-loop;
#X obj 520 445 expr pv_loop = $f1 != 0;
#X obj 520 480 r pv-speed;
#X obj 520 505 expr pv_speed = $f1;
#X obj 700 420 r pv-transpo;
#X obj 700 445 expr pv_tr = pow(2\, $f1/12);
#X obj 880 420 r pv-lock;
#X obj 880 445 s pv-lockval;
#X msg 300 195 1;
#X obj 700 480 r pv-seek;
#X obj 700 505 expr pv_loc = pv_start + min(max($f1\, 0)\, 1)*(pv_end - pv_start);
#X obj 880 170 loadbang;
#X obj 880 195 metro 50;
#X obj 880 225 expr (pv_loc - pv_start) / max(1\, pv_end - pv_start);
#X obj 880 255 clip 0 1;
#X obj 880 280 change;
#X obj 880 305 s pv-pos;
#N canvas 50 50 1200 900 vocoder 0;
#X text 20 5 Vocodeur de phase stereo - fenetre 2048 - recouvrement 4. La phase est calculee sur la somme L+R et appliquee aux deux canaux;
#X obj 20 30 block~ 2048 4;
#X obj 400 30 bang~;
#X obj 400 55 t b b b b;
#X obj 700 80 expr pv_loc = pv_loc + pv_play*pv_speed*512;
#X obj 620 110 expr if(pv_play == 1 && pv_speed > 0 && pv_loc >= pv_end\, 1\, if(pv_play == 1 && pv_speed < 0 && pv_loc <= pv_start\, -1\, 0));
#X obj 620 140 sel 1 -1;
#X obj 620 170 v pv_loop;
#X obj 620 195 sel 1 0;
#X obj 620 225 expr pv_loc = pv_loc - (pv_end - pv_start);
#X obj 780 225 expr pv_play = 0 \; pv_loc = pv_end;
#X obj 900 170 v pv_loop;
#X obj 900 195 sel 1 0;
#X obj 900 255 expr pv_loc = pv_loc + (pv_end - pv_start);
#X obj 1000 225 expr pv_play = 0 \; pv_loc = pv_start;
#X obj 780 255 t b;
#X obj 1000 255 t b;
#X obj 780 285 s pv-endreached;
#X obj 400 110 expr pv_tr;
#X obj 400 320 expr pv_loc - 1024*pv_tr;
#X obj 400 345 t f f;
#X obj 500 370 expr $f1 - 512*pv_tr;
#X obj 400 400 expr int($f1) \; $f1 - int($f1);
#X obj 500 400 expr int($f1) \; $f1 - int($f1);
